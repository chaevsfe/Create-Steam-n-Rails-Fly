{
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create_dd"
      ]
    }
  ],
  "type": "create:sequenced_assembly",
  "conditions": [
    {
      "type": "forge:mod_loaded",
      "modid": "create_dd"
    }
  ],
  "ingredient": "railways:track_create_dd_rubber",
  "loops": 1,
  "sequence": [
    {
      "type": "create:cutting",
      "results": ["$result"],
      "ingredient": "$ingredient",
      "processing_time": 50
    },
    {
      "type": "create:deploying",
      "results": ["$result"],
      "target": "$ingredient",
      "ingredient": "create_dd:rubber_slab"
    },
    {
      "type": "create:pressing",
      "results": ["$result"],
      "ingredient": "$ingredient"
    }
  ],
  "transitional_item": {
    "id": "railways:track_incomplete_create_dd_rubber_wide"
  },
  "result": {
    "id": "railways:track_create_dd_rubber_wide"
  }
}
