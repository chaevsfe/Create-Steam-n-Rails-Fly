{
  "type": "create:sequenced_assembly",
  "ingredient": "minecraft:dark_oak_slab",
  "loops": 1,
  "sequence": [
    {
      "type": "create:cutting",
      "results": ["$result"],
      "ingredient": "$ingredient",
      "processing_time": 50
    },
    {
      "type": "create:deploying",
      "results": ["$result"],
      "target": "$ingredient",
      "ingredient": "#create:track_nuggets"
    },
    {
      "type": "create:pressing",
      "results": ["$result"],
      "ingredient": "$ingredient"
    }
  ],
  "transitional_item": {
    "id": "railways:track_incomplete_dark_oak_narrow"
  },
  "result": {
    "id": "railways:track_dark_oak_narrow"
  }
}
