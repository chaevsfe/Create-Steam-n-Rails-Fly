{
  "type": "create:sequenced_assembly",
  "ingredient": "create:track",
  "loops": 1,
  "sequence": [
    {
      "type": "create:cutting",
      "results": ["$result"],
      "ingredient": "$ingredient",
      "processing_time": 50
    },
    {
      "type": "create:deploying",
      "results": ["$result"],
      "target": "$ingredient",
      "ingredient": "#create:sleepers"
    },
    {
      "type": "create:pressing",
      "results": ["$result"],
      "ingredient": "$ingredient"
    }
  ],
  "transitional_item": {
    "id": "railways:track_incomplete_create_andesite_wide"
  },
  "result": {
    "id": "railways:track_create_andesite_wide"
  }
}
